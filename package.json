{
	"name": "dsh-sol-pi",
	"version": "0.2.0",
	"description": "Native DeepSeek Harness plugin for SoL context and tool-efficiency mechanisms (Pi adapter included)",
	"type": "module",
	"private": true,
	"files": [
		"src/sol-pi",
		"src/sol-core",
		"src/sol-dsh",
		"dist/sol-dsh",
		"assets",
		"docs/compatibility.md",
		"docs/configuration.md",
		"docs/dsh.md",
		"docs/dsh-configuration.md",
		"scripts/check-sol-pi-config.mjs",
		"scripts/check-dsh-compat.mjs",
		"agents-install.md",
		"README.md",
		"README.zh-CN.md",
		"LICENSE",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md",
		"sol-pi.example.json"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check:dsh": "node scripts/check-dsh-compat.mjs",
		"build:dsh": "node scripts/build-sol-dsh.mjs && node scripts/build-sol-dsh-client.mjs",
		"prepack": "npm run build:dsh",
		"check": "npm run typecheck && npm test && npm run check:dsh && npm pack --dry-run"
	},
	"main": "./dist/sol-dsh/index.js",
	"exports": {
		".": "./dist/sol-dsh/index.js",
		"./client": "./dist/sol-dsh/client.js",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./src/sol-dsh/cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-store",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-plugin-manager",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-model-selection"
			],
			"platform": "web",
			"immediately": true
		},
		"engines": {
			"dsh": ">=0.1.7-rc.1"
		}
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"dsh",
		"dsh-plugin",
		"context-management"
	],
	"pi": {
		"extensions": [
			"./src/sol-pi/index.ts"
		]
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-settings": "^0.1.7-rc.1",
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "24.12.4",
		"esbuild": "^0.28.2",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/xinghaix/dsh-sol-pi.git"
	},
	"license": "MIT",
	"dependencies": {
		"@deepseek-ai/schemastery": "^3.18.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
